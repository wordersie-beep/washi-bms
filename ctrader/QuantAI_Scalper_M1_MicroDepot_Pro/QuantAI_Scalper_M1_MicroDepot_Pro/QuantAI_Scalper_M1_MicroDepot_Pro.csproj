<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build outside cTrader:  dotnet build -c Release
    The API is pinned to cTrader.Automate 1.0.0 (cTrader 4.2), the oldest .NET 6 SDK, so the code is proven
    to use nothing newer than cTrader 4.x offers; the produced .algo is accepted by cTrader 4.2+ and 5.x.
    cTrader itself keeps its own project file when the source is pasted into its editor.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AlgoPublish>False</AlgoPublish>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.0" />
  </ItemGroup>
</Project>
