<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the broker-independent parts of the cBot (Naive Bayes, tick velocity engine, outcome
    simulator used for AI labels, squeeze/sweep detectors, TP1 volume split).
    Run:  dotnet run -c Release   (exit code 0 = all passed)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AlgoBuild>False</AlgoBuild>
    <AlgoPublish>False</AlgoPublish>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Harness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../QuantAI_Scalper_M1_MicroDepot_Pro/QuantAI_Scalper_M1_MicroDepot_Pro/QuantAI_Scalper_M1_MicroDepot_Pro.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>
</Project>
